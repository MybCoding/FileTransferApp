<Project Sdk="Microsoft.NET.Sdk">

  <!-- ===================== CORE ===================== -->
  <PropertyGroup>
	  <TargetFrameworks>
		  net8.0-windows10.0.19041.0;
		  net8.0-android
	  </TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>FileTransferApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>FileTransferApp</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.yazdani.filetransferapp</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- OS versions -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <Platforms>AnyCPU;x64</Platforms>

    <!-- Windows SDK (اختیاری؛ اگر مشکل نسخه نداری می‌تونی حذفش کنی) -->
    <WindowsSdkPackageVersion>10.0.19041.53</WindowsSdkPackageVersion>
  </PropertyGroup>

  <!-- ===================== WINDOWS ===================== -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- Taskbar/Desktop ICO -->
	  <ApplicationIcon>Resources\AppIcon\appicon.ico</ApplicationIcon>

	  <!-- Enable automatic deployment for debugging -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Run unpackaged + self-contained Windows App SDK so the exe starts directly
         without requiring MSIX registration or the installed Windows App Runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- ===================== ANDROID (APK + EMBED) ===================== -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-android'">
    <AndroidUseCleartextTraffic>true</AndroidUseCleartextTraffic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-android|AnyCPU'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidKeyStore>True</AndroidKeyStore>
    <AndroidSigningKeyStore>..\..\keystore\filetransferapp-release.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>filetransferapp</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>FileTransfer14040216</AndroidSigningStorePass>
    <AndroidSigningKeyPass>FileTransfer14040216</AndroidSigningKeyPass>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-android|x64'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidKeyStore>True</AndroidKeyStore>
    <AndroidSigningKeyStore>..\..\keystore\filetransferapp-release.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>filetransferapp</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>FileTransfer14040216</AndroidSigningStorePass>
    <AndroidSigningKeyPass>FileTransfer14040216</AndroidSigningKeyPass>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-android|AnyCPU'">
    <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
    <AndroidKeyStore>False</AndroidKeyStore>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-android|x64'">
    <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
    <AndroidKeyStore>False</AndroidKeyStore>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Platforms\Windows\Assets\SplashScreen.png" />
    <None Remove="Resources\AppIcon\appicon.ico" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\AppIcon\appicon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Platforms\Windows\Assets\SplashScreen.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ===================== MAUI RESOURCES ===================== -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.65" Color="#7C3AED" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#7C3AED" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>
  
  <!-- Override MauiSplashScreen for Windows to use Assets folder -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <MauiSplashScreen Remove="Resources\Splash\splash.svg" BackgroundColor="#7C3AED" /> 
   

    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- ===================== WINDOWS ASSETS -> MSIX PACKAGE ===================== -->
  <!-- اضافه کردن فایل‌های Assets به MSIX Package با استفاده از Content و PackagePath -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Content Include="Platforms\Windows\Assets\SplashScreen.png">
      <Pack>true</Pack>
      <PackagePath>Assets\SplashScreen.png</PackagePath>
    </Content>
  </ItemGroup>
  
  <!-- کپی فایل‌ها به AppX/Assets برای build -->
  <Target Name="CopyWindowsAssets" AfterTargets="Build" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ItemGroup>
      <AssetsFiles Include="Platforms\Windows\Assets\*.png" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)$(TargetFramework)\$(RuntimeIdentifier)\AppX\Assets" Condition="'@(AssetsFiles)' != ''" />
    <Copy SourceFiles="@(AssetsFiles)" DestinationFolder="$(OutputPath)$(TargetFramework)\$(RuntimeIdentifier)\AppX\Assets" SkipUnchangedFiles="true" />
  </Target>

  <!-- ===================== PACKAGES ===================== -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.14" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.14" />
    <PackageReference Include="CommunityToolkit.Maui" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

  <!-- ===================== XAML COMPILE (اختیاری) ===================== -->
  <ItemGroup>
    <MauiXaml Update="ChatPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <!-- ===================== ANDROID RESOURCE PATH FIX ===================== -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-android'">
    <AndroidResource Update="Platforms\Android\Resources\values\colors.xml">
      <LogicalName>values\colors.xml</LogicalName>
    </AndroidResource>
  </ItemGroup>

</Project>
