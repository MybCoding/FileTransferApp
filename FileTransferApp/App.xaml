<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:FileTransferApp.Converters"
             x:Class="FileTransferApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <converters:BoolConverter x:Key="BoolConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:BoolToAlignConverter x:Key="BoolToAlignConverter" />
            <converters:InverseBoolConverter x:Key="InvertBoolConverter" />
            <converters:StringIsNotNullOrEmptyConverter x:Key="StringIsNotNullOrEmptyConverter" />
            <!-- استایل آنلاین -->
            <Style x:Key="OnlineStyle" TargetType="Label">
                <Setter Property="TextColor" Value="Green"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>
            <x:Double x:Key="ButtonHeight">50</x:Double>
            <x:Double x:Key="ButtonWidth">100</x:Double>
            <!-- استایل آفلاین -->
            <Style x:Key="OfflineStyle" TargetType="Label">
                <Setter Property="TextColor" Value="Gray"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>