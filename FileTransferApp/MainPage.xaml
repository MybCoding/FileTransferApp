<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FileTransferApp.Models"
             x:Class="FileTransferApp.MainPage"
             x:Name="Page"
             Title="Device Sharing"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}"
             Padding="{OnPlatform Android='12,12,12,12',
                               iOS='12,12,12,12',
                               MacCatalyst='12,12,12,12',
                               WinUI='24,32,24,24',
                               Default='12,12,12,12'}">

    <!-- Root: main content + overlays -->
    <Grid>

        <!-- Main content (Desktop-first width) -->
        <Grid RowDefinitions="Auto,*,Auto,Auto"
              Padding="16"
              HorizontalOptions="Center"
              VerticalOptions="Fill"
              MaximumWidthRequest="920">

            <!-- Header -->
            <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,12" HorizontalOptions="Center">
                <Label Text="Nearby Devices"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#222, Dark=White}" />
                <Label Text="Tap a device to share files or messages"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#666, Dark=#BBB}" />
                <BoxView HeightRequest="1"
                         WidthRequest="260"
                         HorizontalOptions="Center"
                         BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#444}"
                         Margin="0,10,0,0" />
            </VerticalStackLayout>

            <!-- Device List -->
            <RefreshView Grid.Row="1"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding GroupedDevices}"
                                IsGrouped="True"
                                SelectionMode="None"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">

                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="local:DeviceGroup">
                            <Grid Padding="8,10,8,0" HorizontalOptions="Fill">
                                <Frame CornerRadius="12"
                                       HasShadow="False"
                                       Padding="12,8"
                                       HorizontalOptions="Fill"
                                       BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#2B2B2B}"
                                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#444}">
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="IP:"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#333, Dark=White}" />
                                        <Label Text="{Binding Title}"
                                               TextColor="{AppThemeBinding Light=#333, Dark=White}" />
                                        <Label Text="{Binding Count, StringFormat='({0})'}"
                                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}" />
                                    </HorizontalStackLayout>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20" Spacing="8">
                            <Label Text="No devices found."
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#666, Dark=#AAA}" />
                            <Label Text="Try refreshing or check your network."
                                   HorizontalOptions="Center"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#888, Dark=#888}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:DeviceModel">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="Delete"
                                                   BackgroundColor="#E53935"
                                                   Command="{Binding Source={x:Reference Page}, Path=DeleteDeviceCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid Padding="4" Margin="0,6" HorizontalOptions="Fill">
                                    <Frame CornerRadius="16"
                                           BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2C}"
                                           BorderColor="{AppThemeBinding Light=#E5E7EB, Dark=#444}"
                                           HasShadow="True"
                                           Padding="14"
                                           HorizontalOptions="Fill"
                                           MaximumWidthRequest="860">

                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                              VerticalOptions="Center"
                                              ColumnSpacing="12">

                                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#222, Dark=White}" />
                                                <Label Text="{Binding IPAddress}"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light=#777, Dark=#BBB}" />
                                                <HorizontalStackLayout Spacing="6">
                                                    <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center">
                                                        <Ellipse.Fill>
                                                            <SolidColorBrush Color="{Binding StatusColor}" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Label Text="{Binding Status}"
                                                           FontSize="13"
                                                           VerticalOptions="Center"
                                                           TextColor="{Binding StatusColor}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <Button Grid.Column="1"
                                                    Text="Connect"
                                                    BackgroundColor="#2563EB"
                                                    TextColor="White"
                                                    CornerRadius="18"
                                                    HeightRequest="38"
                                                    WidthRequest="100"
                                                    FontAttributes="Bold"
                                                    Command="{Binding Source={x:Reference Page}, Path=SendCommand}"
                                                    CommandParameter="{Binding}">
                                                <!-- XAML-only "animation" via pressed state -->
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup Name="CommonStates">
                                                        <VisualState Name="Normal">
                                                            <VisualState.Setters>
                                                                <Setter Property="Scale" Value="1" />
                                                                <Setter Property="Opacity" Value="1" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Property="Scale" Value="0.97" />
                                                                <Setter Property="Opacity" Value="0.95" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState Name="Disabled">
                                                            <VisualState.Setters>
                                                                <Setter Property="Opacity" Value="0.6" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Button>

                                            <Button Grid.Column="2"
                                                    Text="Pair"
                                                    BackgroundColor="#7C3AED"
                                                    TextColor="White"
                                                    CornerRadius="18"
                                                    HeightRequest="38"
                                                    WidthRequest="90"
                                                    FontAttributes="Bold"
                                                    IsVisible="{Binding ShowPairButton}"
                                                    Command="{Binding Source={x:Reference Page}, Path=PairingCommand}"
                                                    CommandParameter="{Binding}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup Name="CommonStates">
                                                        <VisualState Name="Normal">
                                                            <VisualState.Setters>
                                                                <Setter Property="Scale" Value="1" />
                                                                <Setter Property="Opacity" Value="1" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Property="Scale" Value="0.97" />
                                                                <Setter Property="Opacity" Value="0.95" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState Name="Disabled">
                                                            <VisualState.Setters>
                                                                <Setter Property="Opacity" Value="0.6" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Button>
                                        </Grid>
                                    </Frame>

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Page}, Path=SendCommand}"
                                            CommandParameter="{Binding}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Footer -->
            <VerticalStackLayout Grid.Row="2" Spacing="10" Margin="0,14,0,0" HorizontalOptions="Center">

                <Button Text="Refresh Devices"
                        Clicked="RefreshDeviceList"
                        BackgroundColor="#EC4899"
                        TextColor="White"
                        CornerRadius="22"
                        FontAttributes="Bold"
                        HeightRequest="44"
                        WidthRequest="220"
                        HorizontalOptions="Center">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                    <Setter Property="Opacity" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.97" />
                                    <Setter Property="Opacity" Value="0.95" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.6" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Button>

                <Label Text="{Binding StatusMessage}"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"
                       FontSize="13" />
            </VerticalStackLayout>

            <!-- Bottom links -->
            <HorizontalStackLayout Grid.Row="3" Spacing="18" HorizontalOptions="Center" Margin="0,12,0,0">
                <Label Text="دانلود نسخه ویندوز"
                       FontSize="12"
                       TextColor="#2563EB"
                       TextDecorations="Underline"
                       IsVisible="{OnPlatform WinUI=False, Default=True}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLanDownloadTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="درباره ما"
                       FontSize="12"
                       TextColor="#2563EB"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAboutTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </Grid>

        <!-- ===================== LAN Download overlay (with Close) ===================== -->
        <Grid x:Name="LanOverlay"
              IsVisible="False"
              BackgroundColor="#80000000"
              InputTransparent="False">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseLanTapped" />
            </Grid.GestureRecognizers>

            <Frame Padding="20"
                   CornerRadius="18"
                   HasShadow="True"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   MaximumWidthRequest="560"
                   MinimumWidthRequest="320"
                   BackgroundColor="{AppThemeBinding Light=#F2FFFFFF, Dark=#E62C2C2C}"
                   BorderColor="{AppThemeBinding Light=#33FFFFFF, Dark=#55FFFFFF}"
                   InputTransparent="False">

                <Frame.GestureRecognizers>
                    <!-- prevent overlay from closing when tapping inside -->
                    <TapGestureRecognizer />
                </Frame.GestureRecognizers>

                <Grid RowDefinitions="Auto,*" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Text="دانلود نسخه ویندوز"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light=#222, Dark=White}"
                               VerticalOptions="Center" />

                        <Button Grid.Column="1"
                                Text="✕"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=#333, Dark=White}"
                                Clicked="OnCloseLanClicked"
                                HorizontalOptions="End" />
                    </Grid>

                    <VerticalStackLayout Grid.Row="1" Spacing="10">
                        <Label Text="1) موبایل و کامپیوتر روی یک Wi-Fi باشند."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666, Dark=#CCC}" />
                        <Label Text="2) دکمه Start را بزنید تا یک آدرس LAN ساخته شود."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666, Dark=#CCC}" />
                        <Label Text="3) در ویندوز، همین آدرس را داخل مرورگر وارد کنید."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666, Dark=#CCC}" />

                        <HorizontalStackLayout Spacing="10">
                            <Button Text="{Binding LanServerButtonText}"
                                    BackgroundColor="#22C55E"
                                    TextColor="White"
                                    CornerRadius="18"
                                    HeightRequest="40"
                                    WidthRequest="140"
                                    Clicked="OnLanServerToggle" />
                            <Button Text="Copy URL"
                                    IsEnabled="{Binding IsLanServerRunning}"
                                    BackgroundColor="#64748B"
                                    TextColor="White"
                                    CornerRadius="18"
                                    HeightRequest="40"
                                    WidthRequest="110"
                                    Clicked="OnCopyLanUrl" />
                        </HorizontalStackLayout>

                        <Label Text="{Binding LanServerUrl}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#222, Dark=#EEE}" />

                        <Label Text="Note: اگر صفحه باز نشد، AP Isolation روتر را بررسی کنید."
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#888, Dark=#AAA}" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>
        </Grid>

        <!-- ===================== About overlay ===================== -->
        <Grid x:Name="AboutOverlay"
              IsVisible="False"
              BackgroundColor="#80000000"
              InputTransparent="False">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseAboutTapped" />
            </Grid.GestureRecognizers>

            <Frame Padding="20"
                   CornerRadius="18"
                   HasShadow="True"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   MaximumWidthRequest="520"
                   MinimumWidthRequest="320"
                   BackgroundColor="{AppThemeBinding Light=#F2FFFFFF, Dark=#E62C2C2C}"
                   BorderColor="{AppThemeBinding Light=#33FFFFFF, Dark=#55FFFFFF}"
                   InputTransparent="False">

                <Frame.GestureRecognizers>
                    <TapGestureRecognizer />
                </Frame.GestureRecognizers>

                <Grid RowDefinitions="Auto,*" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Text="درباره ما"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light=#222, Dark=White}"
                               VerticalOptions="Center" />

                        <Button Grid.Column="1"
                                Text="✕"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=#333, Dark=White}"
                                Clicked="OnCloseAboutClicked"
                                HorizontalOptions="End" />
                    </Grid>

                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                        <Image Source="app_icon.png"
                               HeightRequest="120"
                               WidthRequest="120"
                               Margin="0,4,0,6"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />

                        <Label Grid.Row="1"
                               Text="FileTransferApp"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#512BD4, Dark=White}" />

                        <Label Grid.Row="2"
                               x:Name="OverlayVersionLabel"
                               FontSize="13"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#666, Dark=#CCC}" />

                        <Label Grid.Row="3"
                               Text="توسعه دهنده: مصطفی یزدانی"
                               FontSize="16"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#222, Dark=White}" />

                        <Label Grid.Row="4"
                               Text="Mostafa.Yazdani65@gmail.com"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="#1E88E5"
                               TextDecorations="Underline"
                               LineBreakMode="TailTruncation">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAboutEmailTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Label Grid.Row="5"
                               Text="سیاست حریم خصوصی"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="#1E88E5"
                               TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyPolicyTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Grid>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
